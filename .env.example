# ============================================================
# Variables de entorno - JWT Microservices
# Copia este archivo como .env y configura los valores
# NUNCA subas el archivo .env a Git
# ============================================================

# Puerto del servidor Express
PORT=3000

# Rutas a las llaves criptográficas generadas por OpenSSL (RS256)
PRIVATE_KEY_PATH=./keys/private.pem
PUBLIC_KEY_PATH=./keys/public.pem

# Secreto alternativo para firma simétrica HS256 (fallback si no hay llaves)
JWT_SECRET=supersecreto_simetrico_fallback
# Sentry
SENTRY_DSN=
NODE_ENV=development